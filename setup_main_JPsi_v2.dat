Hydro:xmax = 17.
Hydro:dz = .3125
Hydro:zmax = 10.
PreHydro:Tau0 = 0.0166666666666667
PreHydro:Dtau = 0.0166666666666667
PreHydro:Xmax = 17 
PreHydro:Dx = 0.0664062 


