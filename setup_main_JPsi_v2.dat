#For sampling the same collisions as were sampled in the MUSIC event. -CFY 11/2/2010
General:Nbin_from_File = 1
General:Nbin_File_Name NcollList0.dat
#General:evolution_name _AuAu_0t20_tau04
#General:evolution_name /raid/dune/CY_MUSIC_AuAu_manycentralities/evolution_AuAu_viscous_b5.dat
General:evolution_name evolution_xyeta.dat
General:pre_evolution_name epsilon-u-Hydro-t0.

#For examining heavy quarks:
General:setInitialPToZero 0
General:examineHQ 1

PDF:NuclearEffects  = on
PDF:useLHAPDF       = on
PDF:LHAPDFset       = EPPS21nlo_CT18Anlo_208
General:inelasticNNXSec = 67.6
PDF:LHAPDFmember = 0

#General:totalHQXSec .6
General:totalHQXSec 70.
General:charmWidth 0.3
General:bottomWidth 0.3
#General:charmWidth 0.3
#General:bottomWidth 0.3
General:T_C_HQ 0.165
General:coal_prob_path rates 
General:do_coalesence = on
General:coal_sigma 6.142951168
General:coal_N_factor 0.2
General:NColl 1921
General:IPG_filename coarsed_ufield_tau_0.524_eta_1.dat
General:HQ_rate_type 4
General:HQ_Lattice_rate_factor 1.
General:HQ_scat_rad_flag 0
General:HQ_rate_path /rates/ 
General:TwoPiTD_HQ 3.0
