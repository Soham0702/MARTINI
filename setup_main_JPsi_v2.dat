#Glauber:Projectile = p
#Glauber:b = 0.
Glauber:Target = Pb
Glauber:Projectile = Pb
#Glauber:b = 2.31
#Glauber:Target = Au
#Glauber:Projectile = Au
##Glauber:b = 0.
##Glauber:b = 4.47
Glauber:b = 4.
Glauber:MaxInterpolationPoints = 100
Glauber:Envelope = off

HardQCD:all = on
##SoftQCD:all = on
Charmonium:all = on
HadronLevel:Hadronize = off
